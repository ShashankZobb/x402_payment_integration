# x402 demo (DO NOT commit real mainnet keys; testnet only)
PORT=4021
SERVER_URL=http://localhost:4021
FACILITATOR_URL=https://x402.org/facilitator

# Filled by `npm run wallets`. Two wallets:
#   AGENT  spends  -> fund this one
#   SELLER receives
SERVER_PAYTO=
AGENT_PRIVATE_KEY=
# The seller's key. Without it, everything still works but earnings sent to
# SERVER_PAYTO can never be moved — which is exactly how an earlier version of
# this project stranded every payment it ever made. `npm run sweep` needs it.
SERVER_PRIVATE_KEY=

# THE LIMIT: the largest single payment the agent may make.
# Checked per transaction — prior spending is irrelevant, so ten calls at
# this size are ten allowed payments.
# Must be a finite, non-negative number; a typo aborts startup rather than
# silently disabling the check.
MAX_PER_TX_USD=0.05

# OPTIONAL cumulative ceiling across all payments, off unless you set it.
# Leave unset for a per-transaction limit only.
# MAX_TOTAL_USD=1.00

# Seller price per call. The dashboard can override it per request.
PRICE_PER_CALL=$0.01

# How long one paid request may take, retries included (5000-180000).
# On timeout the agent asks USDC whether the authorization was consumed, so an
# abandoned call is still recorded correctly.
REQUEST_TIMEOUT_MS=45000

# ---- AI AGENT ----
# Needed for `npm run task` and the dashboard's agent panel.
# ANTHROPIC_API_KEY=sk-ant-...
# AGENT_MODEL=claude-opus-5

# ---- MOCK MODE: run the whole flow without spending anything ----
# The 402 quote, PaymentGuard, retries and the UI all stay real; only the
# signature, the facilitator and the chain are simulated. Mock payments go to
# .spend-ledger.mock.json so they never mix with real spending.
# MOCK_PAYMENTS=1
# MOCK_USDC=25          # opening simulated balance
# MOCK_FAIL_RATE=0.3    # inject transient failures to exercise the retry path
# MOCK_AI=1             # scripted planner instead of Claude (no API key, no tokens)

# Optional: custom Base Sepolia RPC.
# RPC_URL=https://sepolia.base.org
