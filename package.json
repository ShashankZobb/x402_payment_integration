{
  "name": "ai-payment-x402",
  "version": "1.0.0",
  "description": "AI agent that pays for a useful service via x402 on Base Sepolia with fixed budget enforcement",
  "type": "module",
  "scripts": {
    "wallets": "tsx src/generate-wallets.ts",
    "server": "tsx src/server.ts",
    "agent": "tsx src/agent.ts",
    "budget-check": "tsx src/budget-check.ts",
    "balance": "tsx src/balance.ts",
    "demo": "tsx src/demo.ts",
    "boot": "tsx src/boot.ts",
    "agent:demo": "tsx src/agent.ts --tasks 6",
    "test": "tsx src/budget-check.ts",
    "typecheck": "tsc --noEmit",
    "build": "tsc",
    "start:server": "node dist/server.js",
    "mock:server": "node -e \"process.env.MOCK_PAYMENTS='1';require('child_process').spawn(process.execPath,['./node_modules/tsx/dist/cli.mjs','src/server.ts'],{stdio:'inherit',env:process.env})\"",
    "mock:agent": "node -e \"process.env.MOCK_PAYMENTS='1';require('child_process').spawn(process.execPath,['./node_modules/tsx/dist/cli.mjs','src/agent.ts',...process.argv.slice(1)],{stdio:'inherit',env:process.env})\"",
    "sweep": "tsx src/sweep.ts",
    "task": "tsx src/task.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.125.0",
    "axios": "^1.7.9",
    "dotenv": "^16.4.5",
    "express": "^4.18.2",
    "viem": "^2.21.26",
    "x402": "1.2.0",
    "x402-axios": "1.2.0",
    "x402-express": "1.2.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.12.0",
    "tsx": "^4.7.0",
    "typescript": "^5.4.0"
  },
  "overrides": {
    "x402": "1.2.0"
  }
}
